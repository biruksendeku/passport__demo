# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/passport_demo

# Secret used to sign the express-session cookie
SESSION_SECRET_KEY=replace-with-a-long-random-string

# Port the server listens on (defaults to 3000)
PORT=3000

# Show detailed error JSON instead of a generic 500 page
NODE_ENV=development
