<link rel="stylesheet" href="/css/profile.css" />

<% if(user) { %>
	<p class="email__place"><%= user.email %> </p>

	<h1 style="text-align: center; color: green;"> Profile Access Granted! </h1>

	<br><hr><br>

	<h2 style="text-align: center; color: tomato;"> Welcome <%= user.name %> </h2>
<% } else{ %>
	<h1 style="text-align: center; color: green;"> Profile Access Granted!</h1>
<% } %>
<br><hr><br>

<a href="/logout" style="font-size: 1.5rem; font-weight: 600;"> Logout </a>
<br><hr><br>

<% if(user.role === 'admin') { %>
	<a href="/admin" style="font-size: 1.5rem; font-weight: 600;"> Admin </a>
<% } %>
